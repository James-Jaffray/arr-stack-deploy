# Copy this file to `.env` and fill it in. `.env` is git-ignored.
# Values marked CHANGE_ME are required; setup.sh refuses to continue while they remain.
# Keep values on one line. Inline "# comments" are fine, quotes are optional.

# --- Host / user ---
# User and group IDs the apps run as. Create a dedicated DSM user (e.g. "arr"), then over SSH
# run `id arr`: uid= is PUID, gid= is PGID. Synology IDs are often 1026/100, not 1000/1000.
PUID=1000
PGID=1000
# Timezone name, e.g. America/Edmonton (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Edmonton
# Where app settings live (one subfolder per service). Use the path of the "docker" shared folder.
CONFIG_DIR=/volume1/docker/arr-stack/config
# ONE root that contains torrents/ and media/ (must be a single filesystem so hardlinks work).
# Use the path of the "data" shared folder; it must be on the same volume as your library.
DATA_DIR=/volume1/data
# Your home network in CIDR form; lets the LAN reach qBittorrent through the VPN firewall.
# DSM: Control Panel > Network > Network Interface shows the NAS IP and mask; most are /24
# (e.g. NAS 192.168.1.20, mask 255.255.255.0 gives 192.168.1.0/24).
LAN_SUBNET=192.168.1.0/24

# --- Ports (host side only; container ports never change) ---
# 127.0.0.1 keeps the web UIs off the LAN (Cloudflare Tunnel and same-machine use still work).
BIND_ADDR=0.0.0.0
QBIT_PORT=8080
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878

# --- VPN (required) ---
# Provider name exactly as Gluetun spells it. This setup uses PrivadoVPN.
# Other providers: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_PROVIDER=privado
# Gluetun supports Privado over OpenVPN only.
VPN_TYPE=openvpn
# Your Privado VPN username and password. The username is NOT your email address: copy both from
# your Privado account page (https://app.privadovpn.com). Keep them secret.
OPENVPN_USER=CHANGE_ME
OPENVPN_PASSWORD=CHANGE_ME

# --- Cloudflare Tunnel (optional, run with --profile tunnel) ---
# Token from Cloudflare Zero Trust, Networks, Tunnels. See instructions/05-cloudflare-tunnel.md.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Setup script switches (optional) ---
# SKIP_TUN_CHECK=1
